# Copy to .env and fill in. Never commit .env.
# Values come from your SmartSearch AI administrator.

# Service endpoints
SMARTSEARCH_API_BASE_URL=https://<your-smartsearch-api-host>
SMARTSEARCH_ADMIN_BASE_URL=https://<your-smartsearch-admin-host>
SMARTSEARCH_AUTH_BASE_URL=https://<your-smartsearch-auth-host>
SMARTSEARCH_REALM=<your-realm>

# Service key (issued in the SmartSearch AI admin UI)
SMARTSEARCH_CLIENT_ID=svc-<your-service-principal-id>
SMARTSEARCH_CLIENT_SECRET=<your-service-key-secret>

# Resources your integration uses
SMARTSEARCH_INTEGRATION_ID=<your-integration-id>
SMARTSEARCH_WORKSPACE_ID=<your-workspace-id>
SMARTSEARCH_PROJECT_ID=<your-project-id>
