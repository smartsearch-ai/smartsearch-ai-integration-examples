# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Every value below comes from your SmartSearch AI administrator.
# The hosts shown are placeholders: replace them with the ones you are given.

# --- Where the SDK connects ------------------------------------------------------------

# SmartSearch API gateway. Project search and Workplace (search, answers, chat) go here.
#   Project search: POST {API}/core/projects/{projectId}/search
#   Workplace:      POST {API}/workspace/v1/workspaces/{workspaceId}/search | query | chat
SMARTSEARCH_API_BASE_URL=https://api.your-company.example.com

# Search Admin. User provisioning (registering users, giving access) goes here.
#   POST {ADMIN}/search-admin/api/provisioning/v1/jobs
SMARTSEARCH_ADMIN_BASE_URL=https://admin.your-company.example.com

# Identity server base URL: the part BEFORE /realms/... (no trailing path).
SMARTSEARCH_AUTH_BASE_URL=https://auth.your-company.example.com

# Your realm: the name of your login space on the identity server.
# With the URL above, the SDK gets its tokens from:
#   https://auth.your-company.example.com/realms/your-realm/protocol/openid-connect/token
SMARTSEARCH_REALM=your-realm

# --- Your service key (your application's identity; issued in the Admin UI) ------------

SMARTSEARCH_CLIENT_ID=svc-your-key-id
SMARTSEARCH_CLIENT_SECRET=your-service-key-secret

# --- What your integration uses ---------------------------------------------------------

# Project search: the project to search (your key must be assigned to it).
SMARTSEARCH_PROJECT_ID=your-project-id
# Optional: a use case of that project (SearchThroughUseCase).
SMARTSEARCH_USECASE_ID=your-use-case-id

# Workplace: the workspace to search (your key must be a member), and one of its sources.
SMARTSEARCH_WORKSPACE_ID=your-workspace-id
SMARTSEARCH_SOURCE_ID=your-source-id

# User registration: your provisioning integration and your tenant (organisation) ID.
SMARTSEARCH_INTEGRATION_ID=your-integration-id
SMARTSEARCH_TENANT_ID=your-tenant-id
# Optional: the group granted on SMARTSEARCH_SOURCE_ID by RegisterUsersWithWorkspaceAccess (default: everyone).
SMARTSEARCH_GRANT_GROUP=everyone

# --- Per-user credentials (short-lived) --------------------------------------------------
# Set these in your shell just before running; never store them in a file.
# SMARTSEARCH_USER_ACCESS_TOKEN=   SearchWorkplaceAsUser: the user's SmartSearch AI access token
# SMARTSEARCH_USER_ASSERTION=      SignInWithYourIdentityProvider: a fresh token from your identity provider
