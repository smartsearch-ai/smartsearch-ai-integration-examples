# Copy to .env and fill in. Never commit .env.
# Values come from your SmartSearch AI administrator.

# Service endpoints
SMARTSEARCH_API_BASE_URL=https://<your-smartsearch-api-host>
SMARTSEARCH_ADMIN_BASE_URL=https://<your-smartsearch-admin-host>
SMARTSEARCH_AUTH_BASE_URL=https://<your-smartsearch-auth-host>
SMARTSEARCH_REALM=<your-realm>

# Service key (issued in the SmartSearch AI admin UI)
SMARTSEARCH_CLIENT_ID=svc-<your-service-principal-id>
SMARTSEARCH_CLIENT_SECRET=<your-service-key-secret>

# Resources your integration uses
SMARTSEARCH_INTEGRATION_ID=<your-integration-id>
SMARTSEARCH_TENANT_ID=<your-tenant-id>
SMARTSEARCH_WORKSPACE_ID=<your-workspace-id>
SMARTSEARCH_SOURCE_ID=<a-source-id-in-that-workspace>
SMARTSEARCH_PROJECT_ID=<your-project-id>
SMARTSEARCH_USECASE_ID=<a-use-case-id-in-that-project>

# Optional: the group granted on SMARTSEARCH_SOURCE_ID in example 03 (default: everyone)
SMARTSEARCH_GRANT_GROUP=<a-group-name>

# Per-user credentials for examples 04 and 05. Short-lived: set them just before running,
# never store them in a file.
# SMARTSEARCH_USER_ACCESS_TOKEN=   # 04: the user's SmartSearch AI access token
# SMARTSEARCH_USER_ASSERTION=      # 05: a fresh token from your identity provider for the user
