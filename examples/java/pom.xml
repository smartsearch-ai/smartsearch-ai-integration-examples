<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>co.smartsearchai.examples</groupId>
    <artifactId>smartsearch-ai-java-examples</artifactId>
    <version>1.0.0</version>
    <name>SmartSearch AI Java examples</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <smartsearch-ai.version>0.1.0-SNAPSHOT</smartsearch-ai.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>co.smartsearchai</groupId>
            <artifactId>smartsearch-ai</artifactId>
            <version>${smartsearch-ai.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <!-- mvn -q compile exec:java -Dexec.mainClass=examples.Ex01ServiceConnect -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
